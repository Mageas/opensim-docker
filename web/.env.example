# The portal's own MariaDB account, created by `pnpm setup-db`.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=opensim
MYSQL_USER=opensim_web
MYSQL_PASSWORD=change-me-web

# Only `pnpm setup-db` reads this one.
MYSQL_ROOT_PASSWORD=change-me-root

OPENSIM_GRID_NAME=My OpenSim
OPENSIM_LOGIN_URI=http://127.0.0.1:9000/

# false closes account creation.
SIGNUP_ENABLED=true
