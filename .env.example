# Host the viewers connect to: 127.0.0.1, a LAN IP, or a public DNS name.
OPENSIM_PUBLIC_HOST=127.0.0.1
OPENSIM_HYPERGRID=false

OPENSIM_VERSION=0.9.3.0
OPENSIM_GRID_NAME=My OpenSim
OPENSIM_GRID_NICK=myopensim
OPENSIM_WELCOME=Welcome!

# BulletSim on x86_64, ubODE or basicphysics on ARM.
OPENSIM_PHYSICS=BulletSim

# Used on the first start only.
OPENSIM_REGION_NAME=My Region
OPENSIM_REGION_LOCATION=1000,1000
OPENSIM_REGION_SIZE=256
OPENSIM_ESTATE_NAME=My Estate
OPENSIM_OWNER_FIRSTNAME=Admin
OPENSIM_OWNER_LASTNAME=Opensim
OPENSIM_OWNER_PASSWORD=change-me
OPENSIM_OWNER_EMAIL=admin@example.com

# No ";" in passwords: it separates the fields of the connection string.
MYSQL_DATABASE=opensim
MYSQL_USER=opensim
MYSQL_PASSWORD=change-me-too
MYSQL_ROOT_PASSWORD=change-me-root
# The account portal's own MariaDB account.
MYSQL_WEB_PASSWORD=change-me-web
# false closes account creation on the portal.
PORTAL_SIGNUP_ENABLED=true
MYSQL_BUFFER_POOL=512M
