# Copier en .env puis adapter :  cp .env.example .env

# --- Réseau -------------------------------------------------------------------
# IP publique ou nom DNS par lequel les viewers joignent le serveur.
#   - test sur la même machine : 127.0.0.1
#   - réseau local             : IP LAN du serveur (ex: 192.168.1.50)
#   - Internet                 : ton DNS (ex: monde.mondomaine.fr) + ports 9000 TCP/UDP ouverts
OPENSIM_PUBLIC_HOST=127.0.0.1

# true = Hypergrid : téléportation vers/depuis les autres grilles OpenSim (OSgrid, etc.)
OPENSIM_HYPERGRID=false

# --- Monde --------------------------------------------------------------------
OPENSIM_VERSION=0.9.3.0
OPENSIM_GRID_NAME=Mon OpenSim
OPENSIM_GRID_NICK=monopensim
OPENSIM_WELCOME=Bienvenue sur mon monde !
# BulletSim (défaut x86_64) | ubODE | basicphysics  (sur ARM/Raspberry : ubODE ou basicphysics)
OPENSIM_PHYSICS=BulletSim

# Région créée au 1er démarrage seulement (ensuite : éditer Regions.ini dans le volume)
OPENSIM_REGION_NAME=Ma Region
OPENSIM_REGION_LOCATION=1000,1000
# 256 = région classique ; 512, 1024... = var-region plus grande (multiple de 256)
OPENSIM_REGION_SIZE=256

# Estate + compte administrateur créés au 1er démarrage
OPENSIM_ESTATE_NAME=Mon Estate
OPENSIM_OWNER_FIRSTNAME=Admin
OPENSIM_OWNER_LASTNAME=Opensim
OPENSIM_OWNER_PASSWORD=change-moi
OPENSIM_OWNER_EMAIL=admin@example.com

# --- Base de données ------------------------------------------------------------
# Eviter le caractère ; dans les mots de passe (séparateur de la chaîne de connexion)
MYSQL_DATABASE=opensim
MYSQL_USER=opensim
MYSQL_PASSWORD=change-moi-aussi
MYSQL_ROOT_PASSWORD=change-moi-root
MYSQL_BUFFER_POOL=512M
